{
  "mcpServers": {
    "alice": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--storage-state", ".explore/alice.json",
        "--viewport-size", "390x844",
        "--output-dir", ".explore/alice",
        "--save-session"
      ]
    },
    "bob": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--storage-state", ".explore/bob.json",
        "--viewport-size", "1280x800",
        "--output-dir", ".explore/bob",
        "--save-session"
      ]
    }
  }
}
