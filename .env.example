# Local values: run `npx supabase status` and copy the API URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the email magic-link sign-in. Keep "true" locally (Mailpit catches the mail).
# Leave unset on Vercel until a real SMTP provider is configured in Supabase.
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=true

# Server-only (card import script, DB integration tests). Never expose to the browser.
SUPABASE_SECRET_KEY=
