# Local values: run `npx supabase status` and copy the API URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the email magic-link sign-in. Keep "true" locally (Mailpit catches the mail).
# Leave unset on Vercel until a real SMTP provider is configured in Supabase.
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=true

# Show "Continue with Google". Set "true" only where the Google provider is configured
# (locally: supabase/config.toml + supabase/.env; production: Supabase dashboard). See DEPLOY.md.
# NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true

# ArmoryBot's public Discord application ID (not a secret): the "Add to Discord" button on /discord-bot.
# Without it the page asks people to email for the invite link.
# NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Server-only (card import script, DB integration tests). Never expose to the browser.
SUPABASE_SECRET_KEY=
