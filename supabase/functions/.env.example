# ArmoryBot's Edge Function secrets. Copy to supabase/functions/.env for local
# development (git-ignored; `npx supabase start` / `functions serve` load it).
# Use your DEV Discord application here, never the production one.
# Production values go in with `npx supabase secrets set --env-file <file>`,
# never into Vercel or .env.local.

# Developer portal → General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Developer portal → Bot → Reset Token (only the register script and, from Phase 3, the worker use it)
DISCORD_BOT_TOKEN=

# Shared secret pg_cron/pg_net send to the discord-worker function (same value in Vault as
# 'discord_worker_secret'). At least 32 characters, e.g. from:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
DISCORD_WORKER_SECRET=

# Where buttons link to (your local app, or https://armorypal.vercel.app)
ARMORYPAL_URL=http://localhost:3000
